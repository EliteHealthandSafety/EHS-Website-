# Copy to .env.local (gitignored) to let `npm run sync:pricing` pull live prices
# from the portal's database. Without these the build uses the committed
# snapshot in src/data/pricing-live.json.
#
# The service_role key is a SECRET — it bypasses row-level security. It is used
# only at build time and never ends up in the published site. Never commit it,
# and never put it in client-side code.
#
# Find it in Supabase → Project Settings → API → service_role.

SUPABASE_URL=https://txkfuodkrssvafxyeskg.supabase.co
SUPABASE_SERVICE_KEY=
