---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = `https://elitehealthandsafety.co.uk/${post.id}/`;
// Publish dates are kept in frontmatter for ordering, but not shown - these are
// evergreen guides and a visible 2025 date made a live site read as dormant.
---
<Base title={`${post.data.title} | Elite Health & Safety`} description={post.data.description} canonical={url}>
  <article class="post">
    <div class="wrap post-inner">
      <a class="post-back" href="/blog/">&larr; All articles</a>
      <div class="eyebrow">Health &amp; Safety Blog</div>
      <h1>{post.data.title}</h1>
      <div class="post-body">
        <Content />
      </div>
      <div class="post-cta">
        <div class="eyebrow">Where does your business stand?</div>
        <h2 class="post-cta-h">Check your compliance free, in 5 minutes</h2>
        <p>21 plain-English checks, an instant score and a priority action list. No sign-up.</p>
        <div class="post-cta-row">
          <a class="btn btn-accent" href="/compliance-checklist/">Start the free check</a>
          <a class="btn btn-ghost" href="/contact-us/">Get a free quote</a>
        </div>
      </div>
    </div>
  </article>
</Base>
