---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base
  title="Manual Handling Training Glasgow | Workplace Lifting Courses"
  description="Professional manual handling training courses in Glasgow and across Scotland. Reduce workplace injuries and stay compliant. Book on-site training today."
  canonical="https://elitehealthandsafety.co.uk/manual-handling-training-course/">

  <PageHero
    eyebrow="Manual handling training"
    title="Manual Handling Training in Glasgow"
    lead="Reduce injuries and meet your legal duties with practical manual handling training, delivered on-site and tailored to the real lifting tasks your team faces."
    ctaText="Book manual handling training"
    cta2Text="Ask a question" />

  <section>
    <div class="wrap section-narrow">
      <div class="sec-head">
        <div class="eyebrow">Why it matters</div>
        <h2>Protect your team and stay compliant</h2>
        <p class="lead">Manual handling injuries are among the most common causes of workplace absence. The Manual Handling Operations Regulations 1992 require employers to reduce the risk — our half-day course gives your staff the knowledge and technique to do exactly that.</p>
      </div>
      <ul class="check-list">
        <li>The principles of safe lifting and handling</li>
        <li>Assessing and reducing manual handling risk</li>
        <li>Correct techniques for your specific tasks</li>
        <li>Practical, hands-on demonstration and practice</li>
        <li>Accredited certification on completion</li>
      </ul>
    </div>
  </section>

  <CtaBand heading="Book your manual handling training today." text="Half-day, on-site, tailored to your workplace. Get a date and a price." />
</Base>
