---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base
  title="First Aid Training Glasgow | First Aid Courses Scotland"
  description="Professional first aid training courses in Glasgow and across Scotland. Keep your staff compliant and prepared for emergencies. Book today."
  canonical="https://elitehealthandsafety.co.uk/first-aid-training-course/">

  <PageHero
    eyebrow="First aid training"
    title="First Aid Training Courses in Glasgow"
    lead="Meet your legal first aid requirements and give your staff the confidence to act in an emergency — delivered in-house or on scheduled dates."
    ctaText="Book first aid training"
    cta2Text="Ask a question" />

  <section>
    <div class="wrap section-narrow">
      <div class="sec-head">
        <div class="eyebrow">Courses we offer</div>
        <h2>The right first aid course for your workplace</h2>
        <p class="lead">The Health and Safety (First-Aid) Regulations 1981 require every workplace to have adequate first aid provision. We help you meet it with the appropriate level of training.</p>
      </div>
      <ul class="check-list">
        <li>Emergency First Aid at Work (EFAW) — 1 day</li>
        <li>First Aid at Work (FAW) — 3 days</li>
        <li>FAW requalification &amp; annual refreshers</li>
        <li>Paediatric and bespoke first aid on request</li>
      </ul>
    </div>
  </section>

  <section class="courses">
    <div class="wrap section-narrow">
      <div class="sec-head">
        <div class="eyebrow">What's included</div>
        <h2>Practical, hands-on training</h2>
      </div>
      <ul class="check-list">
        <li>Experienced instructors and small group sizes</li>
        <li>Accredited certification valid for three years</li>
        <li>On-site delivery across Glasgow &amp; Scotland</li>
        <li>All course materials provided</li>
      </ul>
    </div>
  </section>

  <CtaBand heading="Book your first aid training today." text="Tell us how many staff need training and we'll arrange a date that suits you." />
</Base>
