---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { business as b } from '../data/site.js';
import {
  serviceGroups, tiers, howItWorks, memberDiscountPct, missingCodes,
} from '../data/pricing.js';

const gbp = (n) => '£' + n.toLocaleString('en-GB');
const cheapestTier = Math.min(...tiers.map((t) => t.price));

// Surface a curation mistake at build time rather than shipping a gap.
if (missingCodes.length) {
  console.warn(`[pricing] service_code not found in pricing-live.json: ${missingCodes.join(', ')}`);
}
---
<Base
  title="Health & Safety Pricing Glasgow | What It Costs | Elite H&S"
  description={`Clear prices for fire risk assessments, risk assessments, H&S advice and accredited training in Glasgow and Scotland, plus Elite Assured membership from £${cheapestTier} a month. Fixed quote before any work begins.`}
  canonical="https://elitehealthandsafety.co.uk/pricing/">

  <PageHero
    eyebrow="Services & indicative costs"
    title="Practical health & safety support, priced with no surprises"
    lead="A clear guide to what our services cost, so you can budget before you pick up the phone. These are real working rates, not teasers — your final fixed price is confirmed in writing once we've scoped the job."
    ctaText="Get a fixed quote"
    cta2Text="Free compliance check"
    cta2Href="/compliance-checklist/" />

  {serviceGroups.map((g, i) => (
    <section id={g.id} class={i % 2 === 1 ? 'courses' : undefined}>
      <div class="wrap section-narrow">
        <div class="sec-head">
          <div class="eyebrow">{g.id === 'training' ? 'Training' : 'One-off services'}</div>
          <h2>{g.title}</h2>
          <p class="lead">{g.blurb}</p>
        </div>

        <div class="ptable">
          <div class="ptable-head">
            <span>Service</span>
            <span>Price (ex VAT)</span>
          </div>
          {g.items.map((item) => (
            <div class="prow">
              <div class="prow-main">
                <div class="prow-name">{item.name}</div>
                {item.detail && <div class="prow-detail">{item.detail}</div>}
              </div>
              <div class="prow-price">
                <b>{item.from ? 'from ' : ''}{gbp(item.price)}</b>
                {item.unit && <span>{item.unit}</span>}
              </div>
            </div>
          ))}
        </div>
        {g.footnote && <p class="pnote">{g.footnote}</p>}
      </div>
    </section>
  ))}

  <p class="wrap pdisclaimer">
    Prices are ex VAT and shown as a guide to help you budget. Your final fixed price is confirmed in
    your written quote once we've scoped the work — number of sites, size, sector and complexity.
    Travel outside our standard area and any third-party or scheme fees are charged at cost.
    {memberDiscountPct && ` Elite Assured members pay ${memberDiscountPct}% less on work beyond their included allowance.`}
  </p>

  <!-- MEMBERSHIP -->
  <section id="membership" class="courses">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">Elite Assured membership</div>
        <h2>Prefer not to buy piece by piece?</h2>
        <p class="lead">Membership turns one-off jobs into one predictable monthly fee — a bundle of
          support, included work and your own online portal. Every tier includes the portal, and
          members pay less on anything beyond their allowance.</p>
      </div>

      <div class="tier-grid">
        {tiers.map((t) => (
          <article class={`tier${t.popular ? ' is-popular' : ''}`}>
            {t.popular && <div class="tier-flag">Most popular</div>}
            <h3>{t.name}</h3>
            <div class="tier-tag">{t.tagline || t.blurb}</div>
            <div class="tier-price"><b>{gbp(t.price)}</b><span>/month ex VAT</span></div>
            <div class="tier-term">
              {t.minTermMonths ? `Minimum ${t.minTermMonths}-month term` : 'No minimum term'}
            </div>
            {t.who && <p class="tier-who">{t.who}</p>}
            {t.portal && <div class="tier-portal">{t.portal}</div>}
            {t.includes && (
              <ul>
                {t.includes.map((inc) => (
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {inc}
                  </li>
                ))}
              </ul>
            )}
            <a class="btn btn-accent" href="/contact-us/">Ask about {t.name}</a>
          </article>
        ))}
      </div>

      <div class="credit-note">
        <b>How your support allowance works.</b> Behind the included services, your membership carries a
        pool of support credits for the year — so you can flex it across advice, extra site visits, risk
        assessments or documents. Training is separate: each included in-house training day covers one
        on-site session for a group, up to that course's maximum. Your portal shows every balance live,
        and work beyond your allowance is charged at member rates.
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">How we work</div>
        <h2>From first call to fixed quote</h2>
      </div>
      <div class="steps">
        {howItWorks.map((s) => (
          <div class="step">
            <div class="no">0{s.no}</div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Tell us what's on your plate and we'll send a fixed quote."
    text={`A clear, fixed quote — no obligation, and the scoping call is always free. Call ${b.phoneDisplay} or send us the details.`} />
</Base>
