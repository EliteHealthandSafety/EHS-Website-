---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import PricingLadder from '../components/PricingLadder.astro';
import { business as b, showTierFromPrices } from '../data/site.js';
import {
  serviceGroups, howItWorks, missingCodes, memberUpToPct, gbp, gbp2, displayPrice, vatEnabled, vatPctLabel, ladder, tierBands,
} from '../data/pricing.js';

// Surface a curation mistake at build time rather than shipping a gap.
if (missingCodes.length) {
  console.warn(`[pricing] service_code not found in pricing-live.json: ${missingCodes.join(', ')}`);
}
---
<Base
  title="Health & Safety Pricing Glasgow | What It Costs | Elite H&S"
  description="Clear prices for fire risk assessments, risk assessments, H&S advice and accredited training in Glasgow and Scotland, plus Lanyard membership and the Elite Managed Service for ongoing support. Fixed quote before any work begins."
  canonical="https://elitehealthandsafety.co.uk/pricing/">

  <PageHero
    eyebrow="Services & indicative costs"
    title="Practical health & safety support, priced with no surprises"
    lead="A clear guide to what our services cost, so you can budget before you pick up the phone. These are real working rates, not teasers. Your final fixed price is confirmed in writing once we've scoped the job."
    ctaText="Get a fixed quote"
    cta2Text="Free compliance check"
    cta2Href="/compliance-checklist/" />

  {serviceGroups.map((g, i) => (
    <section id={g.id} class={i % 2 === 1 ? 'courses' : undefined}>
      <div class="wrap section-narrow">
        <div class="sec-head">
          <div class="eyebrow">{g.id === 'training' ? 'Training' : 'One-off services'}</div>
          <h2>{g.title}</h2>
          <p class="lead">{g.blurb}</p>
        </div>

        <div class="ptable">
          <div class="ptable-head">
            <span>Service</span>
            <span>{vatEnabled ? 'Price (ex VAT)' : 'Price'}</span>
          </div>
          {g.items.map((item) => (
            <div class="prow">
              <div class="prow-main">
                <div class="prow-name">{item.name}</div>
                {item.detail && <div class="prow-detail">{item.detail}</div>}
              </div>
              <div class="prow-price">
                <b>{item.from ? 'from ' : ''}{gbp(item.price)}</b>
                {item.unit && <span>{item.unit}</span>}
              </div>
            </div>
          ))}
        </div>
        {g.footnote && <p class="pnote">{g.footnote}</p>}
      </div>
    </section>
  ))}

  <p class="wrap pdisclaimer">
    {vatEnabled ? `Prices are ex VAT, with VAT added at ${vatPctLabel}, and shown as a guide` : 'Prices are shown as a guide'} to help you budget. Your final fixed price is confirmed in
    your written quote once we've scoped the work: number of sites, size, sector and complexity.
    Travel outside our standard area and any third-party or scheme fees are charged at cost.
    {ladder.memberSitePct != null && ladder.memberDeskPct != null && ` Lanyard members get up to ${memberUpToPct}% off: ${ladder.memberSitePct}% off site work and ${ladder.memberDeskPct}% off desk work. Your own rates are on your quote.`}
  </p>

  <PricingLadder compact />

  <!-- MEMBERSHIP. P72 (Reiss, 7 Nov 2026): each Lanyard plan as an indicative
       "from" price only (the lowest synced band), never the band table; the
       Managed Service is quoted. -->
  <section id="membership" class="courses">
    <div class="wrap section-narrow">
      <div class="sec-head">
        <div class="eyebrow">Lanyard membership</div>
        <h2>Prefer not to buy piece by piece?</h2>
        <p class="lead">If you would rather not raise a purchase order every time something needs
          doing, a Lanyard membership gives you the platform, a dedicated support line and Elite as your
          competent person for one predictable monthly fee, with member rates on every job.</p>
      </div>

      <div class="member-band">
        <div class="member-main">
          <h3>What membership covers</h3>
          <ul class="check-list">
            <li>Lanyard by Elite Health &amp; Safety: your documents, renewals and reminders, staff and training records in one place</li>
            <li>A dedicated support line for quick questions. Anything that needs work is quoted first, at your member rate</li>
            <li>Elite as your competent person, named on PQQs and accreditation returns</li>
            <li>Your policy pack, built from our template library</li>
            <li>Member rates on every job we do for you, on a term or monthly rolling</li>
            <li>Want the work delivered as well? The Elite Managed Service adds a planned programme of site inspections, with full Lanyard Pro access included</li>
          </ul>
        </div>
        <div class="member-aside">
          <div class="eyebrow" style="color:var(--accent)">Pricing</div>
          {showTierFromPrices && tierBands.length > 0 ? (
            <>
              <ul class="check-list">
                {tierBands.map((t) => <li><span>{t.name}: from <b>{gbp2(t.fromPrice)}</b> a month{vatEnabled ? ' plus VAT' : ''}</span></li>)}
              </ul>
              <p class="pnote">Indicative: your price depends on how many people are on your account, and Lanyard shows it before you sign.</p>
            </>
          ) : (
            <p>Your membership price depends on how many people are on your account, and Lanyard shows it before you sign.</p>
          )}
          <p>The Elite Managed Service is <b>quoted</b> to your sites and services. Site inspections in your plan are at your plan rate, the same at every site and always lower than booking them one at a time. Travel outside our home area is charged at cost. <a href="/how-pricing-works/">How pricing works</a>.</p>
          <p><b>Tell us what you have and we will recommend the right level with a fixed monthly
            price.</b></p>
          <div class="ck-cta-row">
            <a class="btn btn-accent" href="/contact-us/">Ask about membership</a>
            <a class="btn btn-ghost" href={`tel:${b.phone}`}>☎ {b.phoneDisplay}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">How we work</div>
        <h2>From first call to fixed quote</h2>
      </div>
      <div class="steps">
        {howItWorks.map((s) => (
          <div class="step">
            <div class="no">0{s.no}</div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Tell us what's on your plate and we'll send a fixed quote."
    text={`A clear, fixed quote, no obligation, and the scoping call is always free. Call ${b.phoneDisplay} or send us the details.`} />
</Base>
