---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { business as b } from '../data/site.js';
import {
  serviceGroups, howItWorks, memberDiscountPct, missingCodes,
} from '../data/pricing.js';

const gbp = (n) => '£' + n.toLocaleString('en-GB');

// Surface a curation mistake at build time rather than shipping a gap.
if (missingCodes.length) {
  console.warn(`[pricing] service_code not found in pricing-live.json: ${missingCodes.join(', ')}`);
}
---
<Base
  title="Health & Safety Pricing Glasgow | What It Costs | Elite H&S"
  description="Clear prices for fire risk assessments, risk assessments, H&S advice and accredited training in Glasgow and Scotland, plus Elite Assured membership for ongoing support. Fixed quote before any work begins."
  canonical="https://elitehealthandsafety.co.uk/pricing/">

  <PageHero
    eyebrow="Services & indicative costs"
    title="Practical health & safety support, priced with no surprises"
    lead="A clear guide to what our services cost, so you can budget before you pick up the phone. These are real working rates, not teasers — your final fixed price is confirmed in writing once we've scoped the job."
    ctaText="Get a fixed quote"
    cta2Text="Free compliance check"
    cta2Href="/compliance-checklist/" />

  {serviceGroups.map((g, i) => (
    <section id={g.id} class={i % 2 === 1 ? 'courses' : undefined}>
      <div class="wrap section-narrow">
        <div class="sec-head">
          <div class="eyebrow">{g.id === 'training' ? 'Training' : 'One-off services'}</div>
          <h2>{g.title}</h2>
          <p class="lead">{g.blurb}</p>
        </div>

        <div class="ptable">
          <div class="ptable-head">
            <span>Service</span>
            <span>Price (ex VAT)</span>
          </div>
          {g.items.map((item) => (
            <div class="prow">
              <div class="prow-main">
                <div class="prow-name">{item.name}</div>
                {item.detail && <div class="prow-detail">{item.detail}</div>}
              </div>
              <div class="prow-price">
                <b>{item.from ? 'from ' : ''}{gbp(item.price)}</b>
                {item.unit && <span>{item.unit}</span>}
              </div>
            </div>
          ))}
        </div>
        {g.footnote && <p class="pnote">{g.footnote}</p>}
      </div>
    </section>
  ))}

  <p class="wrap pdisclaimer">
    Prices are ex VAT and shown as a guide to help you budget. Your final fixed price is confirmed in
    your written quote once we've scoped the work — number of sites, size, sector and complexity.
    Travel outside our standard area and any third-party or scheme fees are charged at cost.
    {memberDiscountPct && ` Elite Assured members pay up to ${memberDiscountPct}% less on work beyond their included allowance.`}
  </p>

  <!-- MEMBERSHIP — described, not priced. Tiers are being revised, so this
       sends people to a conversation rather than publishing figures that move. -->
  <section id="membership" class="courses">
    <div class="wrap section-narrow">
      <div class="sec-head">
        <div class="eyebrow">Elite Assured membership</div>
        <h2>Prefer not to buy piece by piece?</h2>
        <p class="lead">If you would rather not raise a purchase order every time something needs
          doing, our Elite Assured membership rolls your health &amp; safety into one predictable
          monthly fee — with your own online portal included.</p>
      </div>

      <div class="member-band">
        <div class="member-main">
          <h3>What membership covers</h3>
          <ul class="check-list">
            <li>An agreed programme of site inspections and reports through the year</li>
            <li>Your policies, risk assessments and documents kept current</li>
            <li>An advice line for the questions that come up week to week</li>
            <li>Included training days, booked straight from the portal</li>
            <li>Member rates on anything beyond your allowance</li>
            <li>The portal on every level — documents, renewal reminders and booking in one place</li>
          </ul>
        </div>
        <div class="member-aside">
          <div class="eyebrow" style="color:var(--accent)">Pricing</div>
          <p>Membership levels are tailored to your sites, headcount and sector — and we are
            currently updating them, so we would rather quote you properly than publish a number
            that does not fit your business.</p>
          <p><b>Tell us what you have and we will recommend the right level with a fixed monthly
            price.</b></p>
          <div class="ck-cta-row">
            <a class="btn btn-accent" href="/contact-us/">Ask about membership</a>
            <a class="btn btn-ghost" href={`tel:${b.phone}`}>☎ {b.phoneDisplay}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">How we work</div>
        <h2>From first call to fixed quote</h2>
      </div>
      <div class="steps">
        {howItWorks.map((s) => (
          <div class="step">
            <div class="no">0{s.no}</div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Tell us what's on your plate and we'll send a fixed quote."
    text={`A clear, fixed quote — no obligation, and the scoping call is always free. Call ${b.phoneDisplay} or send us the details.`} />
</Base>
