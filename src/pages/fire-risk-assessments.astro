---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { serviceGroups } from '../data/pricing.js';

const fra = serviceGroups.find((g) => g.id === 'assessments').items[0];
---
<Base
  title="Fire Risk Assessments Glasgow | Business Fire Safety Compliance"
  description="Professional fire risk assessments in Glasgow and across Scotland. Stay compliant with the Fire (Scotland) Act, avoid fines and protect your business."
  canonical="https://elitehealthandsafety.co.uk/fire-risk-assessments/">

  <PageHero
    eyebrow="Fire safety"
    title="Fire Risk Assessments in Glasgow & Scotland"
    lead="A suitable and sufficient fire risk assessment is a legal requirement for your premises. We make compliance straightforward — with clear reports and prioritised actions."
    ctaText="Get a fire risk quote"
    cta2Text="Book a consultation" />

  <section>
    <div class="wrap section-narrow">
      <div class="sec-head">
        <div class="eyebrow">Is your business compliant?</div>
        <h2>What's included in your fire risk assessment</h2>
        <p class="lead">Under the Fire (Scotland) Act 2005 and the Fire Safety (Scotland) Regulations 2006, the responsible person for most premises must have a current fire risk assessment. Here's what you get from ours.</p>
      </div>
      <ul class="check-list">
        <li>A thorough on-site survey of your premises and how it's used</li>
        <li>Identification of fire hazards and people at risk</li>
        <li>Review of escape routes, signage, detection and firefighting equipment</li>
        <li>A clear, suitable-and-sufficient written report</li>
        <li>A prioritised action plan you can actually follow</li>
        <li>Straightforward guidance on what to fix and when</li>
      </ul>

      <div class="price-flash">
        <b>From £{fra.price.toLocaleString('en-GB')}</b>
        <span>ex VAT for a single office, shop or unit — larger or more complex premises are scoped
          individually. <a href="/pricing/">See full pricing</a></span>
      </div>
    </div>
  </section>

  <section class="courses">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">Who we work with</div>
        <h2>All types of premises</h2>
      </div>
      <div class="pill-row">
        <span>Offices</span><span>Retail units</span><span>Warehouses</span><span>Factories</span>
        <span>Residential blocks</span><span>Construction sites</span><span>Care &amp; hospitality</span>
      </div>
    </div>
  </section>

  <CtaBand heading="Book your fire risk assessment today." text="Get a fast, no-obligation quote for your premises anywhere in Scotland." />
</Base>
