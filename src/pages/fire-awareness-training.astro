---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base
  title="Fire Awareness Training for Businesses in Glasgow & Scotland"
  description="Professional fire awareness training in Glasgow and across Scotland. Ensure your staff are prepared and your business is compliant. Book today."
  canonical="https://elitehealthandsafety.co.uk/fire-awareness-training/">

  <PageHero
    eyebrow="Fire awareness training"
    title="Fire Awareness Training in Glasgow & Scotland"
    lead="Give your staff the knowledge to prevent fires and respond safely if one breaks out — a core part of meeting your fire safety duties."
    ctaText="Book fire awareness training"
    cta2Text="Ask a question" />

  <section>
    <div class="wrap section-narrow">
      <div class="sec-head">
        <div class="eyebrow">What you get</div>
        <h2>Prepared staff, safer premises</h2>
        <p class="lead">Fire safety legislation requires employers to provide staff with adequate fire safety training. Our half-day course covers everything your team needs to know.</p>
      </div>
      <ul class="check-list">
        <li>Common causes of workplace fires and how to prevent them</li>
        <li>How fire spreads and the fire triangle</li>
        <li>Your evacuation procedures and everyone's responsibilities</li>
        <li>Safe use of fire extinguishers and when not to tackle a fire</li>
        <li>Accredited certification on completion</li>
      </ul>
    </div>
  </section>

  <CtaBand heading="Book your fire awareness training today." text="On-site training for your whole team, anywhere in Scotland." />
</Base>
