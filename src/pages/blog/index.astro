---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---
<Base title="Health & Safety Blog | Glasgow & Scotland | Elite H&S" description="Guides and updates on fire risk assessments, first aid, IOSH, SSSTS and workplace health & safety across Glasgow and Scotland." canonical="https://elitehealthandsafety.co.uk/blog/">
  <section class="pagehero">
    <div class="wrap">
      <div class="eyebrow">Insights</div>
      <h1>Health &amp; Safety Blog</h1>
      <p class="lead">Practical guidance on fire risk, first aid, training and compliance for businesses across Glasgow and Scotland.</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="post-grid">
        {posts.map((p) => (
          <a class="post-card" href={`/${p.id}/`}>
            <div class="eyebrow">Guide</div>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            <span class="post-more">Read article &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Reading up because something needs sorting?"
    text="Tell us what you're dealing with and we'll give you a straight answer — free 30-minute consultation, no obligation." />
</Base>
