---
import Base from '../../layouts/Base.astro';
import { business as b } from '../../data/site.js';
import { checklist } from '../../data/checklist.js';

// The metadata the results page needs to describe each gap.
const ITEMS = checklist.flatMap((sec) =>
  sec.items.map((i) => ({ id: i.id, t: i.t, section: sec.title, fix: i.fix }))
);
---
<Base
  title="Your H&S Compliance Results | Elite Health & Safety"
  description="Your free health & safety compliance self-check results — your score and a priority action list for your business."
  canonical="https://elitehealthandsafety.co.uk/compliance-checklist/results/">

  <section class="pagehero ck-res-hero">
    <div class="hazard" aria-hidden="true"></div>
    <div class="wrap">
      <a class="post-back" href="/compliance-checklist/">← Change my answers</a>
      <div class="eyebrow">Your result</div>
      <h1>Your compliance check</h1>
    </div>
  </section>

  <section id="ckEmpty" hidden>
    <div class="wrap section-narrow">
      <div class="ck-empty">
        <h2>We haven't got any answers yet</h2>
        <p>Your answers are stored in your own browser, so there's nothing here until you work
          through the check — it takes about five minutes and there's no sign-up.</p>
        <a class="btn btn-accent" href="/compliance-checklist/">Take the free check</a>
      </div>
    </div>
  </section>

  <section id="ckResults" hidden>
    <div class="wrap section-narrow">

      <div class="ck-scorecard">
        <div class="ck-ring-wrap">
          <svg class="ck-ring" viewBox="0 0 120 120" aria-hidden="true">
            <circle cx="60" cy="60" r="52" class="ck-ring-bg" />
            <circle cx="60" cy="60" r="52" class="ck-ring-fg" id="ckRing" />
          </svg>
          <div class="ck-ring-num"><b id="ckPct">0</b><small>%</small></div>
        </div>
        <div class="ck-scoretext">
          <div class="eyebrow">Compliance score</div>
          <h2 id="ckBand">—</h2>
          <p id="ckBandText" class="lead"></p>
          <div class="ck-counts">
            <div class="ck-count ok"><b id="ckYes">0</b><span>In place</span></div>
            <div class="ck-count warn"><b id="ckUnsure">0</b><span>Not sure</span></div>
            <div class="ck-count risk"><b id="ckNo">0</b><span>Not in place</span></div>
            <div class="ck-count na"><b id="ckNa">0</b><span>N/A</span></div>
          </div>
        </div>
      </div>

      <div id="ckGapsWrap">
        <div class="sec-head" style="margin:48px 0 20px">
          <div class="eyebrow">What to do next</div>
          <h2>Your priority actions</h2>
          <p class="lead" id="ckGapsLead"></p>
        </div>
        <ol class="ck-gaps" id="ckGaps"></ol>
      </div>

      <div class="ck-cta">
        <div class="ck-cta-main">
          <div class="eyebrow" style="color:var(--accent)">Free 30-minute consultation</div>
          <h3>Want us to go through this with you?</h3>
          <p>We will confirm what actually applies to your premises, tell you honestly what is urgent
            and what can wait, and quote for anything you want us to take off your hands.
            No obligation, no hard sell.</p>
          <div class="ck-cta-row">
            <a class="btn btn-accent" href="/contact-us/">Book my free review</a>
            <a class="btn btn-onbrand" href={`tel:${b.phone}`}>☎ {b.phoneDisplay}</a>
          </div>
        </div>
      </div>

      <div class="ck-post">
        <div class="ck-post-card">
          <h3>Email these results to yourself</h3>
          <p>Optional — we will send your score and action list so you have a record, and we will only
            get in touch if we think we can genuinely help.</p>
          <form id="ckMail" class="cform">
            <input type="hidden" name="access_key" value={b.web3formsKey} />
            <input type="hidden" name="subject" value="H&S self-check results" />
            <input type="hidden" name="from_name" value="Elite H&S — Compliance Check" />
            <input type="hidden" name="results" id="ckResultsField" />
            <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />
            <div class="cform-row">
              <label>Name<input type="text" name="name" required autocomplete="name" /></label>
              <label>Work email<input type="email" name="email" required autocomplete="email" /></label>
            </div>
            <label>Company (optional)<input type="text" name="company" autocomplete="organization" /></label>
            <div class="cform-actions">
              <button class="btn btn-accent" type="submit">Email me my results</button>
              <p class="cform-status" id="ckMailStatus" role="status" aria-live="polite"></p>
            </div>
          </form>
        </div>

        <div class="ck-post-card">
          <h3>Keep a copy</h3>
          <p>Print your results, or open the blank printable checklist to work through on site.</p>
          <div class="ck-cta-row">
            <button class="btn btn-ghost" type="button" id="ckPrint">🖨 Print my results</button>
            <a class="btn btn-ghost" href="/downloads/ehs-compliance-checklist.html" target="_blank" rel="noopener">Printable checklist</a>
          </div>
          <div class="ck-cta-row" style="margin-top:14px">
            <a class="btn btn-ghost" href="/compliance-checklist/">← Change my answers</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style is:global>
    @media print{
      .util,header.nav,footer,.pagehero,.tt,.ck-post,.ck-cta-row{display:none !important}
      .ck-scorecard,.ck-gap,.ck-cta{box-shadow:none;break-inside:avoid}
      .ck-cta{color:#000;background:none;border:1px solid #999}
      .ck-cta h3,.ck-cta p{color:#000}
    }
  </style>

  <script is:inline define:vars={{ ITEMS }}>
    (function () {
      var KEY = 'ehs-selfcheck-v1';
      var state = {};
      try { state = JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { state = {}; }

      if (!Object.keys(state).length) { document.getElementById('ckEmpty').hidden = false; return; }
      document.getElementById('ckResults').hidden = false;

      var c = { yes: 0, unsure: 0, no: 0, na: 0 };
      ITEMS.forEach(function (i) { var v = state[i.id]; if (v && c[v] !== undefined) c[v]++; });
      var scored = c.yes + c.unsure + c.no;
      var pct = scored ? Math.round((c.yes / scored) * 100) : 0;

      var BANDS = [
        { min: 90, name: 'Strong position', cls: 'ok', text: 'You are in good shape. The value now is in keeping it current — reviews, refreshers and servicing that do not lapse.' },
        { min: 70, name: 'Mostly there, with gaps', cls: 'ok', text: 'The foundations are in place, but the items below are the ones that tend to be picked up in an inspection or after an incident.' },
        { min: 40, name: 'Notable gaps', cls: 'warn', text: 'Enough is missing that an inspection or a serious incident would be uncomfortable. The good news is that most of this is quick to put right.' },
        { min: 0, name: 'Significant risk', cls: 'risk', text: 'Several legal duties look unmet. This is worth acting on now — not as a paperwork exercise, but because these are the controls that protect your people.' }
      ];
      var band = BANDS.find(function (x) { return pct >= x.min; });

      document.getElementById('ckPct').textContent = pct;
      var circ = 2 * Math.PI * 52;
      var ring = document.getElementById('ckRing');
      ring.style.strokeDasharray = circ.toFixed(1);
      ring.style.strokeDashoffset = (circ * (1 - pct / 100)).toFixed(1);

      document.querySelector('.ck-scorecard').classList.add('band-' + band.cls);
      document.getElementById('ckBand').textContent = band.name;
      document.getElementById('ckBandText').textContent = band.text;
      document.getElementById('ckYes').textContent = c.yes;
      document.getElementById('ckUnsure').textContent = c.unsure;
      document.getElementById('ckNo').textContent = c.no;
      document.getElementById('ckNa').textContent = c.na;

      var order = { no: 0, unsure: 1, unanswered: 2 };
      var labels = { no: 'Not in place', unsure: 'Needs checking', unanswered: 'Not answered' };
      var gaps = [];
      ITEMS.forEach(function (i) {
        var v = state[i.id] || 'unanswered';
        if (v === 'yes' || v === 'na') return;
        gaps.push({ key: v, label: labels[v], section: i.section, title: i.t, fix: i.fix });
      });
      gaps.sort(function (a, z) { return order[a.key] - order[z.key]; });

      var list = document.getElementById('ckGaps');
      gaps.forEach(function (g) {
        var li = document.createElement('li');
        li.className = 'ck-gap ' + g.key;
        var tag = document.createElement('span');
        tag.className = 'ck-gap-tag';
        tag.textContent = g.label;
        var s = document.createElement('div');
        s.className = 'ck-gap-s';
        s.textContent = g.section;
        var h = document.createElement('div');
        h.className = 'ck-gap-t';
        h.textContent = g.title;
        var p = document.createElement('p');
        p.textContent = g.fix;
        li.appendChild(tag);
        li.appendChild(s);
        li.appendChild(h);
        li.appendChild(p);
        list.appendChild(li);
      });
      document.getElementById('ckGapsWrap').hidden = gaps.length === 0;
      document.getElementById('ckGapsLead').textContent = gaps.length
        ? 'Ordered by urgency — what is not in place, then what you were unsure about.'
        : '';

      var lines = [
        'COMPLIANCE SELF-CHECK RESULT',
        'Score: ' + pct + '% (' + c.yes + ' in place, ' + c.unsure + ' not sure, ' + c.no + ' not in place, ' + c.na + ' N/A)',
        '',
        'PRIORITY ACTIONS (' + gaps.length + '):'
      ];
      gaps.forEach(function (g, i) {
        lines.push((i + 1) + '. [' + g.label.toUpperCase() + '] ' + g.section + ' — ' + g.title);
        lines.push('   ' + g.fix);
      });
      if (!gaps.length) lines.push('None flagged — everything answered is in place.');
      document.getElementById('ckResultsField').value = lines.join('\n');

      document.getElementById('ckPrint').addEventListener('click', function () { window.print(); });

      var mail = document.getElementById('ckMail');
      var mstatus = document.getElementById('ckMailStatus');
      mail.addEventListener('submit', async function (e) {
        e.preventDefault();
        mstatus.className = 'cform-status';
        mstatus.textContent = 'Sending…';
        try {
          var res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(Object.fromEntries(new FormData(mail)))
          });
          var json = await res.json();
          if (json.success) {
            mail.style.display = 'none';
            mstatus.className = 'cform-status ok';
            mstatus.textContent = 'Sent ✓ — check your inbox. We will be in touch only if we can help.';
          } else {
            mstatus.textContent = json.message || 'Something went wrong — please email us instead.';
            mstatus.className = 'cform-status err';
          }
        } catch (err) {
          mstatus.textContent = 'Network error — email info@elitehealthandsafety.co.uk and we will send it over.';
          mstatus.className = 'cform-status err';
        }
      });
    })();
  </script>
</Base>
