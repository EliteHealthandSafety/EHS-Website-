---
import Base from '../layouts/Base.astro';
---
<Base title="Health & Safety Training Glasgow | Fire Risk, First Aid" description="Professional health & safety training and consultancy in Glasgow & across Scotland. Fire risk assessments, first aid courses & more." canonical="https://elitehealthandsafety.co.uk/">
<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hazard" aria-hidden="true"></div>
  <div class="wrap">
    <div>
      <div class="eyebrow hero-anim" style="color:var(--accent)">Health &amp; Safety Consultancy · Glasgow &amp; Scotland</div>
      <h1 class="hero-anim d1">Keep your people safe and your business <span class="hl">compliant</span>.</h1>
      <p class="lead hero-anim d2">Accredited training, fire risk assessments and hands-on H&amp;S consultancy for businesses across Scotland and UK-wide — trusted on live construction and rail sites.</p>
      <div class="cta-row hero-anim d3">
        <a class="btn btn-accent" href="/contact-us/">Get a free quote
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="btn btn-onbrand" href="/compliance-checklist/">Check your compliance — free</a>
      </div>
      <div class="trustline hero-anim d3">
        <span><i class="dot"></i>Glasgow-based</span>
        <span><i class="dot"></i>UK-wide on site</span>
        <span><i class="dot"></i>Accredited courses</span>
      </div>
    </div>

    <!-- portal teaser card -->
    <div class="panel hero-anim d2" aria-label="Compliance dashboard preview">
      <div class="phead">
        <span class="t">Compliance dashboard</span>
        <span class="live"><b></b>Example</span>
      </div>
      <div class="rows">
        <div class="row">
          <span class="ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 2s7 3 7 8-3 12-7 12-7-7-7-12 7-8 7-8z" stroke="currentColor" stroke-width="1.8"/></svg></span>
          <span><span class="lbl">Fire Risk Assessment</span><br><span class="sub">Next review · Mar 2027</span></span>
          <span class="spring"></span><span class="pill ok">Current</span>
        </div>
        <div class="row">
          <span class="ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><rect x="3" y="3" width="18" height="18" rx="4" stroke="currentColor" stroke-width="1.6"/></svg></span>
          <span><span class="lbl">First Aid at Work</span><br><span class="sub">8 staff certified</span></span>
          <span class="spring"></span><span class="pill ok">Trained</span>
        </div>
        <div class="row">
          <span class="ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span>
          <span><span class="lbl">IOSH Managing Safely</span><br><span class="sub">3 delegates booked</span></span>
          <span class="spring"></span><span class="pill warn">In progress</span>
        </div>
        <div class="row">
          <span class="ic"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 4l8 14H4L12 4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M12 10v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
          <span><span class="lbl">Asbestos Awareness</span><br><span class="sub">Renewal due 30 days</span></span>
          <span class="spring"></span><span class="pill warn">Renew soon</span>
        </div>
      </div>
      <div class="meter">
        <div class="top"><span>Overall compliance</span><span>92%</span></div>
        <div class="bar"><i></i></div>
      </div>
    </div>
  </div>
</section>

<!-- ============ CLIENTS ============ -->
<div class="clients">
  <div class="wrap">
    <span class="cap">Trusted on site by</span>
    <div class="client-names">
      <span class="logo">Balfour Beatty</span>
      <span class="logo">Network Rail</span>
      <span class="logo">Lee Marley</span>
      <span class="logo">OBS Construction</span>
      <span class="logo">Ireland Alloys</span>
      <span class="logo">Curtis Moore</span>
    </div>
  </div>
</div>

<!-- ============ SERVICES ============ -->
<section id="services">
  <div class="wrap">
    <div class="sec-head">
      <div class="eyebrow">What we do</div>
      <h2>Three ways we keep you compliant</h2>
      <p class="lead">From one-off fire risk assessments to a fully managed safety programme — whatever your project, we've got you covered.</p>
    </div>
    <div class="grid-3">
      <article class="card">
        <div class="cic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 11l2 2 4-4M12 3l7 3v6c0 5-3 8-7 9-4-1-7-4-7-9V6l7-3z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <h3>H&amp;S Consultancy</h3>
        <ul>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>CDM 2015 &amp; site inspections</li>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>ISO standards &amp; PQQ advice</li>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Legionella &amp; H&amp;S policies</li>
        </ul>
        <a class="more" href="/services/">Explore consultancy
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </article>
      <article class="card">
        <div class="cic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M3 8l9-4 9 4-9 4-9-4zM7 10.5V15c0 1.5 2.5 3 5 3s5-1.5 5-3v-4.5M21 8v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <h3>Accredited Training</h3>
        <ul>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>IOSH, SSSTS &amp; CITB courses</li>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>First aid, manual handling</li>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>On-site or scheduled dates</li>
        </ul>
        <a class="more" href="/training-courses/">Browse courses
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </article>
      <article class="card">
        <div class="cic"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 2s6 4 6 9c0 3.3-2.7 6-6 6s-6-2.7-6-6c0-1.6.7-3 1.5-4 .3 1 1 1.8 2 2 0-2.5 1-4.5 2.5-7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></div>
        <h3>Fire Risk Assessments</h3>
        <ul>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Suitable &amp; sufficient reports</li>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Fire Safety Order compliance</li>
          <li><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>Clear remedial action plans</li>
        </ul>
        <a class="more" href="/contact-us/">Get a fire risk quote
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </article>
    </div>
  </div>
</section>

<!-- ============ COURSES ============ -->
<section id="courses" class="courses">
  <div class="wrap">
    <div class="sec-head">
      <div class="eyebrow">Training courses</div>
      <h2>Accredited courses, delivered your way</h2>
      <p class="lead">In-house at your premises anywhere in Scotland, or on scheduled dates in Glasgow. Group discounts available.</p>
    </div>
    <div class="course-grid">
      <a class="course" href="/training-courses/"><span class="dur">3 days</span><span class="cn">IOSH Managing Safely</span><span class="go">Book →</span></a>
      <a class="course" href="/training-courses/"><span class="dur">1 day</span><span class="cn">IOSH Working Safely</span><span class="go">Book →</span></a>
      <a class="course" href="/training-courses/"><span class="dur">2 days</span><span class="cn">SSSTS Site Supervisor</span><span class="go">Book →</span></a>
      <a class="course" href="/training-courses/"><span class="dur">1–3 days</span><span class="cn">First Aid at Work</span><span class="go">Book →</span></a>
      <a class="course" href="/training-courses/"><span class="dur">½ day</span><span class="cn">Asbestos Awareness</span><span class="go">Book →</span></a>
      <a class="course" href="/training-courses/"><span class="dur">½ day</span><span class="cn">Manual Handling</span><span class="go">Book →</span></a>
      <a class="course" href="/training-courses/"><span class="dur">½ day</span><span class="cn">Work at Height</span><span class="go">Book →</span></a>
      <a class="course" href="/training-courses/"><span class="dur">½ day</span><span class="cn">Abrasive Wheels</span><span class="go">Book →</span></a>
    </div>
  </div>
</section>

<!-- ============ PORTAL ============ -->
<section id="portal" class="portal-sec">
  <div class="wrap">
    <div class="grid">
      <div>
        <div class="eyebrow" style="color:var(--accent)">The EHS Portal</div>
        <h2>All your compliance, in one place.</h2>
        <p class="lead">Your dedicated client portal keeps every assessment, certificate and booking together — so you always know exactly where you stand.</p>
        <ul class="plist">
          <li><span class="chk"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Live compliance status</b><span>See what's current, due, or overdue at a glance.</span></span></li>
          <li><span class="chk"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>All documents in one place</b><span>Fire risk assessments, certificates and reports, ready to download.</span></span></li>
          <li><span class="chk"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12l4 4L19 7" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Renewal reminders</b><span>Never miss a review date or a certificate expiry again.</span></span></li>
        </ul>
        <div class="cta-row">
          <a class="btn btn-accent" href="https://portal.elitehealthandsafety.co.uk">Access the portal</a>
          <a class="btn btn-onbrand" href="/contact-us/">Book a demo</a>
        </div>
      </div>
      <div class="browser" aria-label="EHS Portal preview">
        <div class="bar"><i></i><i></i><i></i><span class="addr">portal.elitehealthandsafety.co.uk</span></div>
        <div class="body">
          <div class="kpis">
            <div class="kpi"><div class="n">92%</div><div class="k">Compliant</div></div>
            <div class="kpi"><div class="n">2</div><div class="k">Due soon</div></div>
            <div class="kpi"><div class="n">14</div><div class="k">Documents</div></div>
          </div>
          <div class="doc"><span class="fic">PDF</span><span><span class="dn">Fire Risk Assessment — Head Office</span><br><span class="dm">Issued 12 Mar 2026 · valid 12 months</span></span></div>
          <div class="doc"><span class="fic">PDF</span><span><span class="dn">First Aid at Work certificates ×8</span><br><span class="dm">Expires 04 Sep 2027</span></span></div>
          <div class="doc"><span class="fic">DOC</span><span><span class="dn">Health &amp; Safety Policy 2026</span><br><span class="dm">Updated 30 Jun 2026</span></span></div>
        </div>
        <div class="mock-note">Illustrative example of the client portal.</div>
      </div>
    </div>
  </div>
</section>

<!-- ============ STATS ============ -->
<section class="stats">
  <div class="wrap">
    <div class="stat"><div class="n">Glasgow</div><div class="k">&amp; UK-wide</div></div>
    <div class="stat"><div class="n">Free</div><div class="k">30-min consultation</div></div>
    <div class="stat"><div class="n">Accredited</div><div class="k">IOSH &amp; CITB courses</div></div>
    <div class="stat"><div class="n">On-site</div><div class="k">UK-wide delivery</div></div>
  </div>
</section>

<!-- ============ PROCESS ============ -->
<section id="about">
  <div class="wrap">
    <div class="sec-head">
      <div class="eyebrow">How we work</div>
      <h2>A clear path to compliance</h2>
    </div>
    <div class="steps">
      <div class="step"><div class="no">01</div><h3>Assess</h3><p>We review your premises, risks and current documentation to see exactly where you stand.</p></div>
      <div class="step"><div class="no">02</div><h3>Train</h3><p>Your team gets accredited training matched to their roles and your site's real hazards.</p></div>
      <div class="step"><div class="no">03</div><h3>Certify</h3><p>You receive suitable-and-sufficient reports and certificates, filed in your portal.</p></div>
      <div class="step"><div class="no">04</div><h3>Monitor</h3><p>Renewal reminders and ongoing support keep you compliant year after year.</p></div>
    </div>
  </div>
</section>

<!-- ============ FREE TOOL ============ -->
<section class="courses">
  <div class="wrap">
    <div class="promo">
      <div class="promo-txt">
        <div class="eyebrow">Free tool · no sign-up</div>
        <h2>Find out where you actually stand — in 5 minutes</h2>
        <p class="lead">Work through 21 plain-English checks covering fire safety, first aid, policies, training and ongoing management. You get a compliance score and a priority action list straight away. Nothing to fill in first.</p>
        <ul class="check-list">
          <li>Instant score and a worst-first action list</li>
          <li>Covers the duties businesses most often miss</li>
          <li>Free, private, and yours to print or email</li>
        </ul>
        <div class="cta-row" style="margin-top:26px">
          <a class="btn btn-accent btn-lg" href="/compliance-checklist/">Start your free compliance check
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
      <div class="promo-vis" aria-hidden="true">
        <div class="promo-ring">
          <svg viewBox="0 0 120 120"><circle cx="60" cy="60" r="52"/><circle cx="60" cy="60" r="52" class="fg"/></svg>
          <div class="promo-num"><b>?</b><small>Your score</small></div>
        </div>
        <div class="promo-rows">
          <span class="promo-row ok">Fire risk assessment</span>
          <span class="promo-row warn">Legionella assessment</span>
          <span class="promo-row risk">Training records</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FINAL CTA ============ -->
<section id="contact" class="final">
  <div class="hazard" aria-hidden="true"></div>
  <div class="wrap">
    <h2>Let's get your business compliant.</h2>
    <p>Book a free 30-minute consultation and we'll map out exactly what you need — no obligation.</p>
    <div class="cta-row">
      <a class="btn btn-accent" href="/contact-us/">Request a free quote</a>
      <a class="btn btn-onbrand" href="tel:+441413450549">☎ Call 0141 345 0549</a>
    </div>
    <p class="final-alt">
      Not ready to talk yet? <a href="/compliance-checklist/">Take the free compliance check</a> — no sign-up, instant results.
    </p>
  </div>
</section>

<!-- ============ FOOTER ============ -->
</Base>
