---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base
  title="Contact Elite Health & Safety | Glasgow & Scotland"
  description="Contact Elite Health & Safety in Glasgow and across Scotland for a free health & safety consultation, training booking or quote. Get in touch today."
  canonical="https://elitehealthandsafety.co.uk/contact-us/">

  <PageHero
    eyebrow="Get in touch"
    title="Contact Elite Health & Safety"
    lead="Tell us about your business and we'll come back to you quickly with clear, practical next steps — no obligation."
    ctaText="Email us"
    ctaHref="mailto:info@elitehealthandsafety.co.uk" />

  <section>
    <div class="wrap">
      <div class="grid-3">
        <article class="card">
          <div class="eyebrow">Email</div>
          <h3><a href="mailto:info@elitehealthandsafety.co.uk">info@elitehealthandsafety.co.uk</a></h3>
          <p style="color:var(--muted);margin-top:8px">The quickest way to reach us — we aim to reply the same working day.</p>
        </article>
        <article class="card">
          <div class="eyebrow">Phone</div>
          <h3><a href="tel:+441410000000">0141 000 0000</a></h3>
          <p style="color:var(--muted);margin-top:8px">Call us to discuss training, fire risk assessments or a compliance question.</p>
        </article>
        <article class="card">
          <div class="eyebrow">Coverage</div>
          <h3>Glasgow &amp; all of Scotland</h3>
          <p style="color:var(--muted);margin-top:8px">On-site services delivered across Scotland. Company No. SC656384.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="courses section-narrow">
    <div class="wrap section-narrow">
      <div class="sec-head">
        <div class="eyebrow">Free consultation</div>
        <h2>Not sure what you need?</h2>
        <p class="lead">Book a free 30-minute consultation and we'll map out exactly what's required for your business — which assessments, which training, and in what order.</p>
      </div>
      <div class="cta-row" style="display:flex;gap:14px;flex-wrap:wrap">
        <a class="btn btn-accent" href="mailto:info@elitehealthandsafety.co.uk?subject=Free%20consultation%20request">Request a free consultation</a>
      </div>
    </div>
  </section>
</Base>
