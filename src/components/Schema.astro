---
import { business as b } from '../data/site.js';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': b.url + '/#business',
  name: b.legalName,
  url: b.url,
  email: b.email,
  telephone: b.phone,
  description: b.description,
  foundingDate: b.foundingDate,
  priceRange: b.priceRange,
  areaServed: b.areaServed.map((n) => ({ '@type': 'AdministrativeArea', name: n })),
  logo: b.url + '/favicon.svg',
};

// HMRC VAT registration number, no spaces, as schema.org vatID expects.
if (b.vatNumber) schema.vatID = b.vatNumber.replace(/\s+/g, '');

// Publish only the address fields that are actually filled in. For a
// service-area business that means locality/region/country and no street or
// postcode — enough for local search, without exposing a home address.
if (b.address) {
  const parts = Object.fromEntries(Object.entries(b.address).filter(([, v]) => v));
  if (Object.keys(parts).length) schema.address = { '@type': 'PostalAddress', ...parts };
}

// Tells Google we serve customers at their location rather than ours.
if (b.serviceAreaBusiness) {
  schema.serviceArea = b.areaServed.map((n) => ({ '@type': 'AdministrativeArea', name: n }));
}
if (b.openingHours) {
  schema.openingHoursSpecification = [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: b.openingHours.days,
      opens: b.openingHours.opens,
      closes: b.openingHours.closes,
    },
  ];
}
if (b.sameAs && b.sameAs.length) schema.sameAs = b.sameAs;
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
